{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "src/shared/infrastructure/database/seeds/data-seeds/*.json",
        "outDir": "dist/shared/infrastructure/database/seeds/data-seeds",
        "watchAssets": true
      }
    ]
  }
}
